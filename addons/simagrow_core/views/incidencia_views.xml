<odoo>
    <record id="view_simagrow_incidencia_list" model="ir.ui.view">
        <field name="name">simagrow.incidencia.list</field>
        <field name="model">simagrow.incidencia</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="espai_id"/>
                <field name="tipus"/>
                <field name="estat"/>
                <field name="data"/>
            </list>
        </field>
    </record>


    <record id="view_simagrow_incidencia_form" model="ir.ui.view">
        <field name="name">simagrow.incidencia.form</field>
        <field name="model">simagrow.incidencia</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="espai_id"/>
                        <field name="tipus"/>
                        <field name="estat"/>
                        <field name="data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_simagrow_incidencia" model="ir.actions.act_window">
        <field name="name">Incidències</field>
        <field name="res_model">simagrow.incidencia</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_simagrow_incidencia" parent="simagrow_menu_incidencies" action="action_simagrow_incidencia"/>
</odoo>
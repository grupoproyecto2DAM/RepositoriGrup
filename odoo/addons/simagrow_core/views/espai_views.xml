<odoo>
    <record id="view_simagrow_espai_list" model="ir.ui.view">
        <field name="name">simagrow.espai.list</field>
        <field name="model">simagrow.espai</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="zona"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_simagrow_espai_form" model="ir.ui.view">
        <field name="name">simagrow.espai.form</field>
        <field name="model">simagrow.espai</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="zona"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_simagrow_espai" model="ir.actions.act_window">
        <field name="name">Espais</field>
        <field name="res_model">simagrow.espai</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

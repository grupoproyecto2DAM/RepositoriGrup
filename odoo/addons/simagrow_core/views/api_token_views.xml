<odoo>
    <record id="view_simagrow_api_token_list" model="ir.ui.view">
        <field name="name">simagrow.api_token.list</field>
        <field name="model">simagrow.api_token</field>
        <field name="arch" type="xml">
            <list>
                <field name="token"/>
                <field name="usuari_id"/>
                <field name="created_at"/>
                <field name="expires_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_simagrow_api_token_form" model="ir.ui.view">
        <field name="name">simagrow.api_token.form</field>
        <field name="model">simagrow.api_token</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="token" readonly="1"/>
                        <field name="usuari_id"/>
                        <field name="created_at" readonly="1"/>
                        <field name="expires_at"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_simagrow_api_tokens" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">simagrow.api_token</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
